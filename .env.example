# ZenLens - Environment Configuration

# App Configuration
EXPO_DEBUG=false
NODE_ENV=development

# API Configuration (if cloud features added later)
# API_BASE_URL=https://api.example.com
# API_TIMEOUT=30000

# Feature Flags
ENABLE_BACKGROUND_INDEXING=true
ENABLE_BIOMETRIC=true
ENABLE_CLOUD_SYNC=false
ENABLE_ANALYTICS=false

# Performance Tuning
MASONRY_COLUMNS=3
THUMBNAIL_SIZE=200
CACHE_SIZE_MB=50
INDEXING_CONCURRENCY=2
INDEXING_BATCH_SIZE=10

# Search Configuration
SEARCH_TOP_N_RESULTS=20
SEARCH_MIN_SIMILARITY=0.3

# Clustering Configuration
KMEANS_K=8
KMEANS_MAX_ITERATIONS=100
DBSCAN_EPS=0.5
DBSCAN_MIN_POINTS=3

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs

# Database
DATABASE_VACUUM_INTERVAL=86400000
DATABASE_BACKUP_INTERVAL=604800000

# Security
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=8
INACTIVITY_TIMEOUT_MS=300000
ENABLE_PIN_PROTECTION=true

# TFLite Models
TFLITE_IMAGE_EMBEDDING_PATH=image_embedding.tflite
TFLITE_TEXT_EMBEDDING_PATH=text_embedding.tflite
TFLITE_CAPTION_PATH=caption_model.tflite
TFLITE_FACE_DETECTION_PATH=face_detection.tflite

# Developer Settings
DEV_SHOW_CONSOLE=true
DEV_SHOW_PERFORMANCE_METRICS=false
DEV_SKIP_ANIMATION=false
DEV_SEED_DATABASE=false
