{
  "expo": {
    "name": "ZenLens",
    "slug": "zenlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zenlens",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.zenlens.gallery",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow ZenLens to access your photo library",
        "NSPhotoLibraryAddUsageDescription": "Allow ZenLens to save edited photos",
        "NSCameraUsageDescription": "Allow ZenLens to access camera",
        "NSFaceIDUsageDescription": "Use Face ID to unlock ZenLens"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.zenlens.gallery",
      "versionCode": 1,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ZenLens to access your photos.",
          "savePhotosPermission": "Allow ZenLens to save edited photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ZenLens to use Face ID for authentication."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "placeholder-project-id"
      }
    }
  }
}
